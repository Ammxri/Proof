# Proof reads secrets and settings only from environment variables. This file documents them and holds no values.
# Proof never writes these values to caches, manifests, logs, reports or packages.

# API key of a provider. The variable name is set per provider in providers/*.yaml (field api_key_env);
# DEEPSEEK_API_KEY is the name used by the example DeepSeek provider, WESTERN_EU_API_KEY the one of the EU template.
DEEPSEEK_API_KEY=
WESTERN_EU_API_KEY=

# Secret seed for private case sets (PR-F11). Never commit it.
PROOF_PRIVATE_SEED=

# Working directory for cache, runs, private sets and the PDF browser. Default: .proof in the current directory.
PROOF_HOME=
